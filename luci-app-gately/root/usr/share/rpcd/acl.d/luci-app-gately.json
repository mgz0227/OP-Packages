{
	"luci-app-gately": {
		"description": "Grant UCI and UBUS access for luci-app-gately",
		"read": {
			"ubus": {
				"luci.gately": [ "get_info", "get_status", "get_log" ]
			},
			"uci": [ "gately" ],
			"file": {
				"/etc/init.d/gately": [ "exec" ]
			}
		},
		"write": {
			"ubus": {
				"luci.gately": [ "service" ]
			},
			"uci": [ "gately" ],
			"file": {
				"/tmp/gately_info_cache": [ "write" ]
			}
		}
	}
}
